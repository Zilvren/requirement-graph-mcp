{
  "name": "requirement-graph-mcp",
  "version": "1.2.0",
  "description": "A local-first requirement & document graph: import Markdown/TXT/JSON/CSV into a per-project SQLite database and query or visualise it through an MCP server and a local web UI.",
  "type": "commonjs",
  "license": "MIT",
  "author": "Zilv",
  "contributors": [
    "Steven Qiang"
  ],
  "packageManager": "pnpm@11.13.0",
  "keywords": [
    "requirements",
    "requirement-graph",
    "requirements-management",
    "document-graph",
    "mcp",
    "model-context-protocol",
    "codex",
    "sqlite",
    "markdown",
    "local-first"
  ],
  "bin": {
    "requirement-graph": "src/index.js"
  },
  "files": [
    "src/",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Zilvren/requirement-graph-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Zilvren/requirement-graph-mcp/issues"
  },
  "homepage": "https://github.com/Zilvren/requirement-graph-mcp",
  "scripts": {
    "test": "node test/hierarchy.js && node test/smoke.js && node test/web.js && node test/web-ui.js && node test/web-daemon.js && node test/map-view-state.js && node test/mcp-web.js",
    "test:core": "node test/hierarchy.js && node test/smoke.js",
    "test:web": "node test/web.js && node test/web-ui.js && node test/web-daemon.js && node test/map-view-state.js",
    "test:mcp": "node test/mcp-web.js",
    "prepublishOnly": "npm test",
    "semantic-release": "semantic-release",
    "semantic-release:dry": "semantic-release --dry-run"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "semantic-release": "^25.0.9"
  }
}
